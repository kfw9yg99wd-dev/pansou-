# Copy this file to .env in your editor. Never commit real credentials.
# Replace BOTH placeholders before starting. Generate separate random values,
# e.g. with: openssl rand -hex 32
AUTH_ENABLED=true
AUTH_USERS=owner:REPLACE_ME_WITH_A_RANDOM_PASSWORD
AUTH_JWT_SECRET=REPLACE_ME_WITH_A_DIFFERENT_RANDOM_SECRET
AUTH_TOKEN_EXPIRY=12

# Container listener; the included compose.yml only publishes it on loopback.
PANSOU_LISTEN_HOST=0.0.0.0
PORT=8888
PANSOU_HTTP_PORT=8080

ENABLED_PLUGINS=pansearch,quarksoo,quarktv,ouge,duoduo,hunhepan,feikuai,nyaa,rrbt,cldi,clmao,clxiong,btbtlb,shandian,zhizhen,labi,muou,wanou,yunso,yunsou,gaoqing888,hdmoli,haitunsou
CHANNELS=tgsearchers7,Aliyun_4K_Movies,Quark_Movies,bdwpzhpd,Channel_Shares_115,wp123zy,cilidianying,ciliziyuanku
CONCURRENCY=8
OUTBOUND_MAX_CONCURRENCY=8
PLUGIN_TIMEOUT=12
PLUGIN_BATCH_TIMEOUT_SECONDS=12
TG_CHANNEL_TIMEOUT_SECONDS=10
TG_CHANNEL_REQUEST_TIMEOUT_SECONDS=8
ASYNC_MAX_BACKGROUND_WORKERS=8
ASYNC_MAX_BACKGROUND_TASKS=40
ASYNC_RESPONSE_TIMEOUT=4
CACHE_ENABLED=true
CACHE_PATH=/app/cache
CACHE_MAX_SIZE=64
CACHE_TTL=60
ASYNC_LOG_ENABLED=false
PLUGIN_SEARCH_DETAIL_LOG=false
GOMAXPROCS=2
GOMEMLIMIT=384MiB
PANSOU_ALLOWED_ORIGINS=
